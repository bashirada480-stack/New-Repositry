    <!-- Phone speaker and home indicator -->
    <path
        android:pathData="M49,30 h10"
        android:strokeColor="#94A3B8"
        android:strokeWidth="2.0"
        android:strokeLineCap="round" />
    <path
        android:pathData="M51,77 h6"
        android:strokeColor="#94A3B8"
        android:strokeWidth="2.0"
        android:strokeLineCap="round" />

