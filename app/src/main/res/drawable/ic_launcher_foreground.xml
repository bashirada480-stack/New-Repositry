    <!-- Telemetry Pulse Wave inside shield -->
    <path
        android:pathData="M46,51 L50,51 L52.5,46 L55.5,56 L58.5,49 L60.5,51 L62,51"
        android:strokeColor="#10B981"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Live indicator beacon -->
    <path
        android:pathData="M54,34 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
        android:fillColor="#34D399" />
