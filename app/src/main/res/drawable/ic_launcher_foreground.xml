        android:strokeWidth="2.2">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="37"
                android:endX="54"
                android:endY="65"
                android:type="linear">
                <item android:offset="0.0" android:color="#2206B6D4" />
                <item android:offset="1.0" android:color="#443B82F6" />
            </gradient>
        </aapt:attr>
