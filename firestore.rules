rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document: only the authenticated user can read or update their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Registered devices subcollection: isolated strictly per user
      match /devices/{deviceId} {
        // Only the owner can view or update their authorized devices
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Audit and activity events stream
        match /events/{eventId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
    
    // Deny all other access by default (Zero-Trust)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
